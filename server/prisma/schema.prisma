generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  SHOP_OWNER
  SHOP_EMPLOYEE
  CUSTOMER
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
  DELETED
  PERMANENTLY_ANONYMIZED
}

enum ShopStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
  PAUSED
}

enum EmployeeRole {
  MANAGER
  STAFF
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum Gender {
  MEN
  WOMEN
  UNISEX
  KIDS
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  EXPIRED
  REFUND_PENDING
}

enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ITEM_SHIPPED
  ITEM_RECEIVED
  REFUND_PENDING
  REFUNDED
  REPLACEMENT_SENT
  CLOSED
  CANCELLED
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  MISSING_ITEM
  NOT_AS_DESCRIBED
  QUALITY_ISSUE
  CHANGED_MIND
  OTHER
}

enum ReturnResolution {
  REFUND
  REPLACEMENT
}

enum ShippingMethod {
  STANDARD
  EXPRESS
  PICKUP
}

enum CheckoutStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum PaymentProvider {
  STRIPE
  PAYPAL
}

enum NotificationType {
  ORDER_PLACED
  ORDER_SHIPPED
  ORDER_DELIVERED
  PAYMENT_SUCCESS
  PAYMENT_REFUNDED
  PAYMENT_FAILED
  REVIEW_RECEIVED
  COUPON_EXPIRING
  MEMBERSHIP_EXPIRING
  RETURN_REQUESTED
  RETURN_UPDATED
}

enum MembershipPlanType {
  USER
  SHOP
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

// ─────────────────────────────────────────
// IDENTITY & AUTH
// ─────────────────────────────────────────

model User {
  id                String        @id @default(cuid())
  name              String
  email             String        @unique
  password          String
  role              Role          @default(CUSTOMER)
  status            AccountStatus @default(PENDING)
  isEmailVerified   Boolean       @default(false)
  deletedAt         DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  passwordChangedAt DateTime?

  profile            UserProfile?
  cart               Cart?
  refreshTokens      RefreshToken[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  ownedShops         Shop[]                  @relation("ShopOwner")
  employeeOf         ShopEmployee[]
  orders             Order[]
  reviews            Review[]
  notifications      Notification[]
  notificationPref   NotificationPreference?
  membership         UserMembership?
  auditLogs          AuditLog[]
  activityLogs       ActivityLog[]
  couponUsages       CouponUsage[]
  paymentMethods     PaymentMethod[]
  checkouts          Checkout[]
  wishlistItems      WishlistItem[]
  returnRequests     ReturnRequest[]
  supportTickets     SupportTicket[]

  @@index([email])
  @@index([status])
  @@index([role])
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  phone     String?
  avatar    String?
  address   String?
  city      String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  token      String   @unique
  ipAddress  String?
  userAgent  String?
  deviceName String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ─────────────────────────────────────────
// TENANT / SHOP
// ─────────────────────────────────────────

model Shop {
  id        String     @id @default(cuid())
  ownerId   String
  owner     User       @relation("ShopOwner", fields: [ownerId], references: [id])
  slug      String     @unique
  status    ShopStatus @default(PENDING)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  profile            ShopProfile?
  employees          ShopEmployee[]
  products           Product[]
  orders             Order[]
  coupons            Coupon[]
  membership         ShopMembership?
  analytics          ShopAnalytics[]
  reviews            Review[]
  notifications      Notification[]
  legalInfo          ShopLegalInfo?
  wallet             ShopWallet?
  walletTransactions WalletTransaction[]

  @@index([ownerId])
  @@index([slug])
  @@index([status])
}

model ShopProfile {
  id             String   @id @default(cuid())
  shopId         String   @unique
  shop           Shop     @relation(fields: [shopId], references: [id])
  name           String
  description    String?
  logo           String?
  banner         String?
  phone          String?
  email          String?
  address        String?
  city           String?
  country        String?
  website        String?
  shippingPolicy String?
  returnsPolicy  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ShopLegalInfo {
  id                String   @id @default(cuid())
  shopId            String   @unique
  shop              Shop     @relation(fields: [shopId], references: [id])
  legalBusinessName String
  taxId             String
  entityType        String // free text for now — "individual", "llc", etc. Not enum-constrained, kept minimal per scope.
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ShopWallet {
  id              String   @id @default(cuid())
  shopId          String   @unique
  shop            Shop     @relation(fields: [shopId], references: [id])
  balance         Decimal  @default(0)
  stripeAccountId String?  @unique
  payoutsEnabled  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WalletTransaction {
  id           String                @id @default(cuid())
  shopId       String
  shop         Shop                  @relation(fields: [shopId], references: [id])
  orderId      String?
  order        Order?                @relation(fields: [orderId], references: [id])
  type         WalletTransactionType
  amount       Decimal
  balanceAfter Decimal
  note         String?
  createdAt    DateTime              @default(now())

  @@index([shopId])
  @@index([orderId])
}

model PlatformWallet {
  id        String   @id @default(cuid())
  balance   Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformWalletTransaction {
  id           String                @id @default(cuid())
  checkoutId   String?
  checkout     Checkout?             @relation(fields: [checkoutId], references: [id])
  type         WalletTransactionType
  amount       Decimal
  balanceAfter Decimal
  note         String?
  createdAt    DateTime              @default(now())

  @@index([checkoutId])
}

model ShopEmployee {
  id        String       @id @default(cuid())
  shopId    String
  shop      Shop         @relation(fields: [shopId], references: [id])
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  role      EmployeeRole @default(STAFF)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  permissions ShopEmployeeRole[]

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
}

model ShopEmployeeRole {
  id         String       @id @default(cuid())
  employeeId String
  employee   ShopEmployee @relation(fields: [employeeId], references: [id])
  permission String
  createdAt  DateTime     @default(now())

  @@unique([employeeId, permission])
}

// ─────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────

model ProductCategory {
  id        String            @id @default(cuid())
  shopId    String
  name      String
  slug      String
  parentId  String?
  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime          @default(now())

  @@unique([shopId, slug])
  @@index([shopId])
}

// PLATFORM-WIDE categories 
model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  imageUrl    String?
  description String?
  icon        String?
  isFeatured  Boolean    @default(false)
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())

  products Product[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive, sortOrder])
}

model Product {
  id                 String    @id @default(cuid())
  shopId             String
  shop               Shop      @relation(fields: [shopId], references: [id])
  categoryId         String?
  platformCategoryId String?
  platformCategory   Category? @relation(fields: [platformCategoryId], references: [id])

  gender    Gender? // ← MEN, WOMEN, UNISEX, KIDS
  tags      String[] // ← ["running", "casual", "waterproof"]
  cartItems CartItem[]
  category  ProductCategory? @relation(fields: [categoryId], references: [id])

  name        String
  description String?       @db.Text
  slug        String
  sku         String?
  type        ProductType   @default(PHYSICAL)
  status      ProductStatus @default(DRAFT)
  basePrice   Decimal
  stock       Int           @default(0)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  variants      ProductVariant[]
  images        ProductImage[]
  digitalAsset  DigitalAsset?
  orderItems    OrderItem[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  analytics     ProductAnalytics[]
  coupons       CouponProduct[]

  @@unique([shopId, slug])
  @@unique([shopId, sku])
  @@index([shopId, status])
  @@index([status])
  @@index([type])
  @@index([categoryId, status])
  @@index([platformCategoryId, status])
  @@index([name])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  name      String
  price     Decimal
  stock     Int      @default(0)
  sku       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  cartItems  CartItem[]

  @@unique([productId, sku])
  @@index([productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ReturnRequest {
  id           String           @id @default(cuid())
  orderId      String
  order        Order            @relation(fields: [orderId], references: [id])
  customerId   String
  customer     User             @relation(fields: [customerId], references: [id])
  status       ReturnStatus     @default(REQUESTED)
  reason       ReturnReason
  resolution   ReturnResolution @default(REFUND)
  customerNote String?          @db.Text
  evidenceUrls String[]
  sellerNote   String?          @db.Text
  adminNote    String?          @db.Text
  requestedAt  DateTime         @default(now())
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  items         ReturnItem[]
  statusHistory ReturnStatusHistory[]

  @@index([orderId])
  @@index([customerId, createdAt])
  @@index([status])
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  quantity        Int
  createdAt       DateTime      @default(now())

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

model ReturnStatusHistory {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  status          ReturnStatus
  note            String?
  createdAt       DateTime      @default(now())

  @@index([returnRequestId, createdAt])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id])
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
}

model DigitalAsset {
  id            String   @id @default(cuid())
  productId     String   @unique
  product       Product  @relation(fields: [productId], references: [id])
  fileUrl       String
  fileSize      Int
  mimeType      String
  downloadLimit Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────
// ORDER & CHECKOUT
// ─────────────────────────────────────────

model Checkout {
  id                String         @id @default(cuid())
  customerId        String
  customer          User           @relation(fields: [customerId], references: [id])
  totalAmount       Decimal
  status            CheckoutStatus @default(PENDING)
  providerPaymentId String?        @unique
  idempotencyKey    String         @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  orders               Order[]
  payment              Payment?
  platformTransactions PlatformWalletTransaction[]

  @@index([customerId])
  @@index([status])
}

model Order {
  id                   String      @id @default(cuid())
  checkoutId           String
  checkout             Checkout    @relation(fields: [checkoutId], references: [id])
  shopId               String
  shop                 Shop        @relation(fields: [shopId], references: [id])
  customerId           String
  customer             User        @relation(fields: [customerId], references: [id])
  status               OrderStatus @default(PENDING)
  totalAmount          Decimal
  couponId             String?
  coupon               Coupon?     @relation(fields: [couponId], references: [id])
  discountAmount       Decimal     @default(0)
  idempotencyKey       String      @unique
  notes                String?
  reservationExpiresAt DateTime?
  deletedAt            DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  shippingAddress    ShippingAddress?
  shipment           OrderShipment?
  returnRequests     ReturnRequest[]
  walletTransactions WalletTransaction[]

  @@index([checkoutId])
  @@index([shopId])
  @@index([customerId])
  @@index([status])
  @@index([idempotencyKey])
  @@index([customerId, status])
  @@index([customerId, createdAt])
  @@index([status, reservationExpiresAt])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id])
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  quantity    Int
  unitPrice   Decimal
  createdAt   DateTime        @default(now())
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model ShippingAddress {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  fullName   String
  phone      String
  address    String
  city       String
  country    String
  postalCode String?
  createdAt  DateTime @default(now())
}

model OrderShipment {
  id                     String         @id @default(cuid())
  orderId                String         @unique
  order                  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method                 ShippingMethod @default(STANDARD)
  fee                    Decimal        @default(0)
  estimatedDeliveryStart DateTime?
  estimatedDeliveryEnd   DateTime?
  carrier                String?
  trackingNumber         String?
  trackingUrl            String?
  note                   String?
  shippedAt              DateTime?
  deliveredAt            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([method])
  @@index([trackingNumber])
}

// ─────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────

model Payment {
  id                String          @id @default(cuid())
  checkoutId        String          @unique
  checkout          Checkout        @relation(fields: [checkoutId], references: [id])
  amount            Decimal
  currency          String          @default("USD")
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider
  providerPaymentId String?         @unique
  idempotencyKey    String          @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status])
  @@index([providerPaymentId])
}

model PaymentMethod {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  provider         PaymentProvider
  providerMethodId String
  last4            String?
  brand            String?
  isDefault        Boolean         @default(false)
  createdAt        DateTime        @default(now())

  @@index([userId])
}

model WebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())

  @@index([type])
}

// ─────────────────────────────────────────
// COUPON
// ─────────────────────────────────────────

model Coupon {
  id             String     @id @default(cuid())
  shopId         String
  shop           Shop       @relation(fields: [shopId], references: [id])
  code           String
  type           CouponType
  value          Decimal
  minOrderAmount Decimal?
  maxUses        Int?
  usedCount      Int        @default(0)
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  usages   CouponUsage[]
  orders   Order[]
  products CouponProduct[]

  @@unique([shopId, code])
  @@index([shopId])
  @@index([code])
}

model CouponProduct {
  couponId  String
  productId String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
  @@index([couponId])
  @@index([userId])
}

// ─────────────────────────────────────────
// REVIEW
// ─────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reply ReviewReply?

  @@unique([productId, userId])
  @@index([shopId])
  @@index([productId])
  @@index([userId])
}

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String   @unique
  review    Review   @relation(fields: [reviewId], references: [id])
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

// ─────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  shopId    String?
  shop      Shop?            @relation(fields: [shopId], references: [id])
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([shopId])
}

model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  emailEnabled Boolean  @default(true)
  pushEnabled  Boolean  @default(true)
  orderUpdates Boolean  @default(true)
  promotions   Boolean  @default(true)
  reviews      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─────────────────────────────────────────
// MEMBERSHIP
// ─────────────────────────────────────────

model MembershipPlan {
  id           String             @id @default(cuid())
  type         MembershipPlanType
  name         String
  price        Decimal
  billingCycle String
  features     Json
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  shopMemberships ShopMembership[]
  userMemberships UserMembership[]
}

model ShopMembership {
  id        String         @id @default(cuid())
  shopId    String         @unique
  shop      Shop           @relation(fields: [shopId], references: [id])
  planId    String
  plan      MembershipPlan @relation(fields: [planId], references: [id])
  status    String         @default("active")
  startedAt DateTime       @default(now())
  expiresAt DateTime
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([shopId])
  @@index([status])
}

model UserMembership {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id])
  planId    String
  plan      MembershipPlan @relation(fields: [planId], references: [id])
  status    String         @default("active")
  startedAt DateTime       @default(now())
  expiresAt DateTime
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────
// ANALYTICS
// ─────────────────────────────────────────

model ShopAnalytics {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id])
  date         DateTime
  totalOrders  Int      @default(0)
  totalRevenue Decimal  @default(0)
  totalVisits  Int      @default(0)
  newCustomers Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([shopId, date])
  @@index([shopId])
  @@index([date])
}

model ProductAnalytics {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  date      DateTime
  views     Int      @default(0)
  clicks    Int      @default(0)
  purchases Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([productId, date])
  @@index([productId])
  @@index([date])
}

// ─────────────────────────────────────────
// AUDIT & ACTIVITY
// ─────────────────────────────────────────

model AuditLog {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  action    AuditAction
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  ip        String?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}


// -----------------------------------------
// SUPPORT TICKETS
// -----------------------------------------

model SupportTicket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique
  subject      String
  category     TicketCategory
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)

  // Can be submitted by guest or logged-in user
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Guest fields (used if userId is null)
  guestName  String?
  guestEmail String?

  messages TicketMessage[]

  assignedToId String?
  // No relation needed - just store admin user id

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([ticketNumber])
}

model TicketMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  body String @db.Text

  // Who sent it - either a user (customer) or an admin (by userId + isStaff flag)
  senderId   String?
  isStaff    Boolean @default(false)
  senderName String? // cached display name

  createdAt DateTime @default(now())

  @@index([ticketId])
}

enum TicketCategory {
  ORDER_ISSUE
  PAYMENT_ISSUE
  ACCOUNT_ISSUE
  PRODUCT_ISSUE
  SHIPPING_ISSUE
  RETURN_ISSUE
  GENERAL
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
